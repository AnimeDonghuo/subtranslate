# Create a bot with @BotFather. Never commit your real token or secret.
BOT_TOKEN=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Optional on Koyeb: the bot uses KOYEB_PUBLIC_DOMAIN automatically.
# Elsewhere, use an HTTPS origin with no trailing path, e.g. https://bot.example.com
WEBHOOK_BASE_URL=
# Optional: comma-separated numeric Telegram user IDs allowed to use the bot.
ALLOWED_USER_IDS=
PORT=8080
# TRANSLATION_TIMEOUT_SECONDS=900
# CHROMIUM_PATH=/usr/bin/chromium
