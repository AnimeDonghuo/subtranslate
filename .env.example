# Create a bot with @BotFather. Never commit your real token or secret.
BOT_TOKEN=
# Optional, but needed for SRTs over the public Bot API's transfer limits.
# Use the same bot token; never share these values publicly.
API_ID=
API_HASH=
# Webhook authentication is derived automatically; no separate secret is needed.
# Optional on Koyeb or Railway: the bot uses KOYEB_PUBLIC_DOMAIN or RAILWAY_PUBLIC_DOMAIN automatically.
# Elsewhere, use an HTTPS origin with no trailing path, e.g. https://bot.example.com
WEBHOOK_BASE_URL=
# Optional: comma-separated numeric Telegram user IDs allowed to use the bot.
ALLOWED_USER_IDS=
PORT=8080
# TRANSLATION_TIMEOUT_SECONDS=900
# CHROMIUM_PATH=/usr/bin/chromium
# Optional browser-only proxy pool (configure as a Koyeb secret; never use untrusted proxies).
# WEBSITE_PROXIES=http://user:password@proxy.example:8080,socks5://proxy2.example:1080
# Supported vless:// links also work; the Docker image includes Xray.
